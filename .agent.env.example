# Local Dev Agent configuration
# Copy this file to .agent.env and edit it.

# The command the agent must run before committing.
# For this template repository, the smoke test is enough.
TEST_COMMAND="bash scripts/smoke-test.sh"

# Number of fix attempts Claude should make after a failing test.
MAX_FIX_ATTEMPTS=3

# Create a branch automatically when the current branch is main/master.
CREATE_BRANCH=true
BRANCH_PREFIX="agent"
BASE_BRANCHES="main master"

# Refuse to start if there are uncommitted changes.
# This avoids mixing human work and agent work.
REQUIRE_CLEAN_WORKTREE=true

# Commit automatically only when Claude verifies success.
COMMIT_ON_SUCCESS=true

# Claude Code options.
# text | json | stream-json
CLAUDE_OUTPUT_FORMAT="text"

# Optional. Leave empty for normal Claude Code behavior.
# Examples: default, acceptEdits, plan, auto, dontAsk, bypassPermissions
# Use bypassPermissions only in an isolated disposable environment.
CLAUDE_PERMISSION_MODE=""

# Optional. Set to true only if you use ANTHROPIC_API_KEY or explicit settings.
# Bare mode skips local Claude Code auto-discovery and is useful for strict scripts.
CLAUDE_BARE=false

# Optional. Override the Claude model used for each run.
# Examples: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
# Leave empty to use the Claude Code default.
CLAUDE_MODEL=""

# Timeout in seconds for a single Claude run. 0 = no timeout.
# Requires 'timeout' (Linux) or 'gtimeout' (macOS: brew install coreutils).
CLAUDE_TIMEOUT_SECONDS=600

# Send a desktop notification when a run completes or fails.
# Uses osascript on macOS and notify-send on Linux.
NOTIFY=true

# Optional. Example:
# CLAUDE_SETTINGS_FILE=".claude/settings.local.json"
CLAUDE_SETTINGS_FILE=""

# Loop settings.
LOOP_INTERVAL_SECONDS=1800
MAX_RUNS=0
